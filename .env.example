SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C0123456789

# Approval
APPROVAL_EMOJI=white_check_mark
REJECT_EMOJI=x
REQUIRED_APPROVALS=2
# Optional comma-separated Slack user IDs. Empty means any user can approve.
APPROVER_USER_IDS=

# Polling
POLL_INTERVAL_SECONDS=30
TASK_LOOKBACK_LIMIT=20
RUN_ONCE=false

# Local paths
WORKSPACE_ROOT=C:\CE\talkKing
STATE_DIR=state
PROMPTS_DIR=prompts
LOGS_DIR=logs

# dry-run writes prompt files only. execute runs CODEX_COMMAND with CODEX_ARGS_TEMPLATE.
CODEX_EXECUTION_MODE=dry-run
CODEX_COMMAND=codex
# Example only. Adjust to your local Codex CLI.
CODEX_ARGS_TEMPLATE=exec --prompt-file "{{promptFile}}"
